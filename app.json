{
  "expo": {
    "name": "atkitchens",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AdaptiveLogo.png",
    "scheme": "atkitchens",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF4D6",
        "foregroundImage": "./assets/images/AdaptiveLogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.burg.atkitchens"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF4D6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c7c1ca6e-e759-4b71-bf5a-90a70ab24c8f"
      }
    }
  }
}